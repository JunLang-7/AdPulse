{
  "openapi": "3.0.3",
  "info": {
    "title": "AdPulse Console API",
    "version": "0.1.0"
  },
  "security": [
    {
      "sessionCookie": []
    }
  ],
  "paths": {
    "/auth/feishu/login": {
      "get": {
        "operationId": "beginFeishuLogin",
        "security": [],
        "parameters": [{ "name": "returnTo", "in": "query", "required": false, "schema": { "type": "string" } }],
        "responses": { "302": { "description": "Redirect to Feishu authorization" }, "400": { "description": "Invalid return target" } }
      }
    },
    "/auth/feishu/callback": {
      "get": {
        "operationId": "completeFeishuLogin",
        "security": [],
        "parameters": [
          { "name": "code", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "state", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "error", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": { "303": { "description": "Redirect to the validated in-app target" }, "503": { "description": "Temporarily unavailable" } }
      }
    },
    "/api/me": {
      "get": {
        "operationId": "getCurrentUser",
        "responses": {
          "200": { "description": "Current authenticated user", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CurrentUser" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/api/logout": {
      "post": {
        "operationId": "logout",
        "security": [{ "sessionCookie": [], "sameOriginOrigin": [] }],
        "responses": {
          "200": { "description": "Session revoked", "content": { "application/json": { "schema": { "type": "object", "properties": { "ok": { "type": "boolean" } }, "required": ["ok"], "additionalProperties": false } } } },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Same-origin request required" }
        }
      }
    },
    "/api/tasks": {
      "get": {
        "operationId": "listTasks",
        "responses": {
          "200": {
            "description": "Success",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/TaskVersion" } } }, "required": ["items"], "additionalProperties": false } } }
          },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      },
      "post": {
        "operationId": "createTask",
        "security": [{ "sessionCookie": [], "sameOriginOrigin": [] }],
        "parameters": [{ "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TaskInput" } } } },
        "responses": {
          "201": { "description": "Created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TaskVersion" } } } },
          "400": { "description": "Invalid request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "409": { "description": "Idempotency conflict", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/api/tasks/{taskId}": {
      "parameters": [{ "name": "taskId", "in": "path", "required": true, "schema": { "type": "string" } }],
      "get": {
        "operationId": "getTask",
        "responses": {
          "200": { "description": "Success", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TaskDetail" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "404": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      },
      "patch": {
        "operationId": "reviseTask",
        "security": [{ "sessionCookie": [], "sameOriginOrigin": [] }],
        "parameters": [{ "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TaskRevision" } } } },
        "responses": {
          "200": { "description": "Updated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TaskVersion" } } } },
          "400": { "description": "Invalid request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "404": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "409": { "description": "Idempotency or task version conflict", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
