  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "adpulse_session"
      },
      "sameOriginOrigin": {
        "type": "apiKey",
        "in": "header",
        "name": "Origin",
        "description": "Must exactly equal the configured PUBLIC_ORIGIN for mutations."
      }
    },
    "schemas": {
      "CurrentUser": {
        "type": "object",
        "properties": {
          "userId": { "type": "string" },
          "sessionExpiresAt": { "type": "string", "format": "date-time" }
        },
        "required": ["userId", "sessionExpiresAt"],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "TaskObservation": {
        "type": "object",
        "properties": {
          "scope": { "type": "string" },
          "startsAt": { "type": "string", "format": "date-time" },
          "endsAt": { "type": "string", "format": "date-time" }
        },
        "required": [],
        "additionalProperties": false
      },
      "TaskRules": {
        "type": "object",
        "properties": {
          "metricDefinition": { "type": "string" },
          "currency": { "type": "string" },
          "unit": { "type": "string" },
          "statWindowDays": { "type": "integer", "minimum": 0 },
          "alertThresholdMinor": { "type": "integer", "minimum": 0 },
          "minimumSpendMinor": { "type": "integer", "minimum": 0 },
          "minimumConsultations": { "type": "integer", "minimum": 0 },
          "handlingDeadlineHours": { "type": "integer", "minimum": 0 },
          "maxPushRounds": { "type": "integer", "minimum": 1 }
        },
        "required": [],
        "additionalProperties": false
      },
      "TaskInput": {
        "type": "object",
        "properties": {
          "product": { "type": "string", "minLength": 1, "maxLength": 200 },
          "strategy": { "$ref": "#/components/schemas/Strategy" },
          "observation": { "$ref": "#/components/schemas/TaskObservation" },
          "rules": { "$ref": "#/components/schemas/TaskRules" }
        },
        "required": ["product", "strategy", "observation", "rules"],
        "additionalProperties": false
      },
      "TaskVersion": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "taskId": { "type": "string" },
          "version": { "type": "integer", "minimum": 1 },
          "product": { "type": "string" },
          "strategy": { "$ref": "#/components/schemas/Strategy" },
          "observation": { "$ref": "#/components/schemas/TaskObservation" },
          "rules": { "$ref": "#/components/schemas/TaskRules" },
          "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "taskId", "version", "product", "strategy", "observation", "rules", "createdAt"],
        "additionalProperties": false
      },
      "TaskRevision": {
        "type": "object",
        "properties": {
          "expectedTaskVersion": { "type": "integer", "minimum": 1 },
          "task": { "$ref": "#/components/schemas/TaskInput" }
        },
        "required": ["expectedTaskVersion", "task"],
        "additionalProperties": false
      },
      "TaskDetail": {
        "type": "object",
        "properties": {
          "task": { "$ref": "#/components/schemas/TaskVersion" },
          "versions": { "type": "array", "items": { "$ref": "#/components/schemas/TaskVersion" } }
        },
        "required": ["task", "versions"],
        "additionalProperties": false
      },
      "Strategy": {
        "type": "object",
        "properties": {
          "objective": {
            "type": "string"
          },
          "audience": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "channels": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "budget": {
                  "type": "number"
                },
                "bidCpc": {
                  "type": "number"
                },
                "enabled": {
                  "type": "boolean"
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "sellingPoints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "objective",
          "audience",
          "channels",
          "sellingPoints"
        ],
        "additionalProperties": false
      },
      "Limits": {
        "type": "object",
        "properties": {
          "maxBudgetChangeRatio": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "maxBidChangeRatio": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "maxBudgetChangeRatio",
          "maxBidChangeRatio"
        ],
        "additionalProperties": false
      },
      "Signal": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                },
                "sourceUrl": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "required": [
                "label",
                "value"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "title",
          "summary",
          "evidence"
        ],
        "additionalProperties": false
      },
      "Recipient": {
