# 部署配置示例：复制为 .deploy.local.env（已 gitignore）后填写。
# 这些是环境信息，不要提交到仓库；脚本不支持也不提供任何实例默认值。
# 每行 KEY=VALUE，# 开头为注释；同名环境变量可以覆盖这里的值。

# ssh 主机别名或 user@host（需已配置免密登录）
DEPLOY_HOST=

# 服务器路径（绝对路径或 ~/ 开头）
DEPLOY_RELEASE_ROOT=~/adpulse-releases
DEPLOY_LINK=~/adpulse-deploy
DEPLOY_ENV_FILE=~/.local/state/adpulse/api.env
DEPLOY_LOG_DIR=~/.local/state
DEPLOY_BACKUP_DIR=~/.local/state

# 服务端口（API 只监听本机回环，由反向代理对外）
DEPLOY_PORT=3401

# 服务器上的运行时（Node 24+ 运行服务与测试；Bun 只用于安装依赖与构建）
DEPLOY_NODE=~/.local/opt/node24/bin/node
DEPLOY_BUN=~/.bun/bin/bun

# 可选：健康检查路径，默认 /api/me（未登录应返回 401）
# DEPLOY_HEALTH_PATH=/api/me
