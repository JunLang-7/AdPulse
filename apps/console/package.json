{
	"name": "@adpluse/console-app",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"sdk:generate": "openapi-typescript ../../contracts/openapi.json -o src/generated/api.d.ts",
		"sdk:check": "node ../../scripts/check-sdk.mjs",
		"test:components": "node --import tsx --import ./test/setup.ts --test --test-force-exit test/*.test.tsx"
	},
	"dependencies": {
		"@base-ui/react": "^1.4.1",
		"@iconify/react": "^6.0.2",
		"@tanstack/react-query": "^5.99.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.14.0",
		"motion": "^12.42.2",
		"openapi-fetch": "^0.17.0",
		"react": "^19.2.5",
		"react-dom": "^19.2.5",
		"react-router": "^7.14.2",
		"simplebar-react": "^3.3.2",
		"tailwind-merge": "^3.5.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@svgr/rollup": "8.1.0",
		"@tailwindcss/postcss": "^4.2.4",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/jsdom": "^30.0.0",
		"@types/node": "^25.6.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.1",
		"jsdom": "^31.0.0",
		"openapi-typescript": "^7.13.0",
		"postcss": "^8.5.13",
		"tailwindcss": "^4.2.4",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vite": "^8.0.10"
	}
}
