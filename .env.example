# Bun loads .env for scripts; services are still executed by Node.js.
# Demo deliveries are simulated and memory data disappears on exit.
DEMO_MODE=1
PUBLIC_ORIGIN=http://localhost:5173
PORT=3000
EMBED_WORKER=1
# Proactive decision delivery remains off until a controlled rollout is explicitly authorized.
# Requires separate per-user decision-card confirmation and active subscription/consent.
DECISION_CARDS_ENABLED=0

# Required outside memory demo; also required for a separate worker process.
# DATABASE_URL=postgres://adpulse:local-password@127.0.0.1:5432/adpulse

# Required by the API for Feishu enterprise login and the internal Feishu channel.
# Use a dedicated test app and tenant; do not reuse production or operator credentials.
FEISHU_ACCOUNT_ID=feishu-internal
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_TENANT_KEY=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# Dedicated disposable database only. Never point tests at production.
# TEST_DATABASE_URL=postgres://postgres:local-password@127.0.0.1:5433/adpulse_test

# Optional. Server-side only, used by the staged task intake.
# DEEPSEEK_API_KEY=
# To use an alternate HTTPS OpenAI-compatible gateway, set all four values.
# TASK_DRAFT_PROVIDER=openai-compatible
# TASK_DRAFT_GATEWAY_BASE_URL=https://gateway.example/v1
# TASK_DRAFT_GATEWAY_MODEL=
# TASK_DRAFT_GATEWAY_API_KEY=
# Optional on a trusted HTTPS deployment. Enables per-user, in-memory API-key connections.
# TASK_DRAFT_USER_KEYS_ENABLED=1

# Persisted personal model credentials (#86). Required as a pair; without a valid
# keyring the feature stays unavailable and nothing is written in plaintext.
# Format: comma-separated keyId:base64(32 bytes). Last entry is active unless
# MODEL_CREDENTIAL_ACTIVE_KEY names another one. Keep the old key while rotating.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# MODEL_CREDENTIAL_KEYRING=v1:
# MODEL_CREDENTIAL_ACTIVE_KEY=v1

# ---- 企业官网发现（搜索源）----
# 按优先级：国内索引 > Bing（免key默认）> 其他。
# 0 个密钥也能跑（只用 Bing 免费源），但中文企业召回质量会差（实测海尔选错站）。
#
# Tavily（推荐，最简单）：https://app.tavily.com → Google 登录 → 首页复制 tvly- 开头的 Key。
# 免费额度：每月 1000 次，无需绑卡。
# TAVILY_API_KEY=
#
# 百度千帆 AI 搜索（中文召回最好）：https://console.bce.baidu.com/qianfan/
# → 千帆大模型平台 → 应用接入 → 创建 API Key。
# 免费额度：每月 1500 次（按天发放约 50 次）。
# BAIDU_QIANFAN_API_KEY=
#
# Exa 官方 API：https://dashboard.exa.ai → API Keys。有免费额度。
# EXA_API_KEY=
#
# Serper（Google 结果）：https://serper.dev → 有免费试用 2500 次。
# SERPER_API_KEY=
#
# Brave Search：https://api-dashboard.search.brave.com → 有免费额度每月 2000 次。
# BRAVE_API_KEY=
#
# agent-reach CLI（Exa 后端，免费但限流）：见开发指南 §Agent-Reach。
# AGENT_REACH_BIN=C:\path\to\agent-reach.exe
#
# 单源日限额（可选）。不配用默认：baidu:100,bocha:100,bing:200,exa:50,其他:100。
# SEARCH_DAILY_LIMITS=baidu:100,bocha:100,bing:200,exa:50,serper:100,brave:100,exa-api:100,tavily:100
#
# 定时发现（#222）：默认关闭。设 1 后每天 08:00（北京时间）对每个已登记企业官网
# 跑一轮「site:官网域名 企业名 新闻」站内索引搜索，新结果进未核验线索并自动排模型初判；
# 搜索额度按日计入上表限额，用完即停。初判还需在控制台配置个人模型连接。
# DISCOVERY_SCHEDULE_ENABLED=0
#
# 博查搜索（你已决定不用，不配即可）：
# BOCHA_API_KEY=
