# Bun loads .env for scripts; services are still executed by Node.js.
# Demo deliveries are simulated and memory data disappears on exit.
DEMO_MODE=1
CONSOLE_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
CONSOLE_USER_ID=operator
PORT=3000
EMBED_WORKER=1

# Required outside memory demo; also required for a separate worker process.
# DATABASE_URL=postgres://adpulse:local-password@127.0.0.1:5432/adpulse

# Set all values together to enable one internal Feishu application.
# FEISHU_ACCOUNT_ID=feishu-internal
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_TENANT_KEY=
# FEISHU_VERIFICATION_TOKEN=
# FEISHU_ENCRYPT_KEY=

# Dedicated disposable database only. Never point tests at production.
# TEST_DATABASE_URL=postgres://postgres:local-password@127.0.0.1:5433/adpulse_test
